{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:language(fr|en)/projects/crown", "destination": "/:language/#work", "permanent": true },
    { "source": "/projects/crown", "destination": "/#work", "permanent": true }
  ],
  "rewrites": [
    { "source": "/:language(fr|en)", "destination": "/:language/index.html" },
    { "source": "/:language(fr|en)/projects/:project(pokou-ai|edge-forensics|bridget)", "destination": "/:language/projects/:project/index.html" },
    { "source": "/projects/:project(pokou-ai|edge-forensics|bridget)", "destination": "/projects/:project/index.html" },
    { "source": "/((?!assets/|project-shots/|images/|favicon\\.svg|robots\\.txt|sitemap\\.xml|og-preview\\.).*)", "destination": "/index.html" }
  ]
}
